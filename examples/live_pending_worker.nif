(stmts
  (variables :pc.0. :pending.0.)
  (def :Init.0. (and (prime pc.0. 0) (prime pending.0. (true))))
  (def :Worker.0. (prime pc.0. (minus 1 pc.0.)))
  (def :Next.0. Worker.0.)
  (def :Inv.0. (and (in pc.0. (range 0 1)) (eq pending.0. (true))))
  (def :Goal.0. (not pending.0.))
  (def :FairWorker.0. Worker.0.)
  (spec (always-stutter Init.0. Next.0. (tuple pc.0. pending.0.)))
  (check Inv.0.))
