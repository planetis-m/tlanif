(stmts
  (variables :pc.0.)
  (def :Init.0. (prime pc.0. 0))
  (def :A.0. (and (lt pc.0. 2) (prime pc.0. (minus 1 pc.0.))))
  (def :B.0. (prime pc.0. 2))
  (def :Next.0. (or A.0. A.0. B.0.))
  (def :Group.0. (or A.0. B.0. A.0.))
  (def :Overlap.0. (exists :x.0 (set 0 1) (and (eq x.0 pc.0.) A.0.)))
  (def :Noop.0. (unchanged pc.0.))
  (def :Inv.0. (in pc.0. (range 0 2)))
  (def :Goal.0. (eq pc.0. 2))
  (def :Vacuous.0. (true))
  (def :Never.0. (false))
  (spec (always-stutter Init.0. Next.0. (tuple pc.0.)))
  (check Inv.0.))
