(stmts
  (constants :Limit.0.)
  (assign Limit.0. 50000)
  (variables :pc.0.)
  (def :Init.0. (prime pc.0. 0))
  (def :Step.0. (and (lt pc.0. Limit.0.) (prime pc.0. (plus pc.0. 1))))
  (def :Next.0. Step.0.)
  (def :Inv.0. (and (ge pc.0. 0) (le pc.0. Limit.0.)))
  (def :Goal.0. (eq pc.0. Limit.0.))
  (spec (always-stutter Init.0. Next.0. (tuple pc.0.)))
  (check Inv.0.))
